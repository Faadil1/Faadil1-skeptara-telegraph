# Skeptara T0 only. Copy values into your local shell or a private .env file.
# NEVER commit a real private key.

# Current official Telegraph testnet route (docs updated Aug 2026).
TELEGRAPH_BASE_URL=https://devnode.telegraphprotocol.com
TELEGRAPH_ENGINE_URL=https://devnode.telegraphprotocol.com/engine
TELEGRAPH_DISCOVERY_URL=https://devnode.telegraphprotocol.com/api/miners

# Telegraph's x402 challenge is authoritative. Base Sepolia is currently documented.
EVM_NETWORK=eip155:*
TELEGRAPH_EVM_PRIVATE_KEY=0xREPLACE_LOCALLY_ONLY

# Optional: override the bounded T0 security challenge query.
SKEPTARA_T0_QUERY=Find material security evidence that should block merging a dependency change to lodash@4.17.20. Return concrete vulnerabilities or advisories if supported by the available Telegraph intelligence.
